<UserControl
    d:DesignHeight="800"
    d:DesignWidth="800"
    mc:Ignorable="d"
    xmlns:splitViewPane="clr-namespace:Baballonia.ViewModels.SplitViewPane"
    x:Class="Baballonia.Views.DebugView"
    x:DataType="splitViewPane:DebugViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Classes="Page" Spacing="12">
      <TextBlock Classes="Header" Margin="0,10,0,-6" Text="Eye diagnostic package" />

      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <StackPanel Spacing="10">
          <TextBlock
              FontWeight="SemiBold"
              Text="Record a short tracking problem for offline analysis"
              TextWrapping="Wrap" />
          <TextBlock
              Opacity="0.75"
              Text="Start eye tracking first. The recording runs for at most 20 seconds and stores synchronized left/right eye images, raw model output, filtered output, avatar values, calibration settings, camera transforms, and the selected personalized eye model. Nothing is uploaded automatically."
              TextWrapping="Wrap" />
          <Border Background="#33FF8C00" CornerRadius="6" Padding="10">
            <TextBlock
                Text="Privacy warning: the ZIP contains images of your eyes and your personalized eye model. Review it and send it only to someone you trust."
                TextWrapping="Wrap" />
          </Border>
          <CheckBox
              Content="I understand what the diagnostic ZIP contains"
              IsChecked="{Binding DiagnosticConsent}" />
          <TextBox
              AcceptsReturn="True"
              MinHeight="56"
              Text="{Binding DiagnosticNotes}"
              TextWrapping="Wrap"
              Watermark="Describe the visible problem and what you did during the recording" />
          <WrapPanel Orientation="Horizontal">
            <Button
                Command="{Binding StartEyeDiagnosticCommand}"
                Content="Start 20-second recording"
                Margin="0,0,8,8"
                IsEnabled="{Binding CanStartEyeDiagnostic}" />
            <Button
                Command="{Binding StopEyeDiagnosticCommand}"
                Content="Stop and create ZIP"
                Margin="0,0,8,8"
                IsEnabled="{Binding CanStopEyeDiagnostic}" />
            <Button
                Command="{Binding OpenEyeDiagnosticFolderCommand}"
                Margin="0,0,8,8"
                Content="Open export folder" />
          </WrapPanel>
          <TextBlock
              IsVisible="{Binding IsEyeDiagnosticRecording}"
              FontWeight="SemiBold"
              Text="{Binding DiagnosticSecondsRemaining, StringFormat='Recording: {0} seconds remaining'}" />
          <TextBlock Text="{Binding DiagnosticStatus}" TextWrapping="Wrap" />
          <Border Background="#332E7DFF" CornerRadius="6" Padding="10">
            <StackPanel Spacing="8">
              <TextBlock
                  FontWeight="SemiBold"
                  Text="Optional encrypted upload"
                  TextWrapping="Wrap" />
              <TextBlock
                  Text="Only after you click Upload, the ZIP is encrypted on this computer with the maintainer public key. The server stores only the encrypted .babdiag report privately in the EU and schedules deletion after 14 days. Cloudflare necessarily processes normal network metadata such as the IP address while transferring it. After local decryption, the report contains eye images and the personalized eye model."
                  TextWrapping="Wrap" />
              <CheckBox
                  Content="I consent to encrypt and upload this eye-image diagnostic report"
                  IsChecked="{Binding DiagnosticUploadConsent}" />
              <WrapPanel Orientation="Horizontal">
                <Button
                    Command="{Binding UploadEyeDiagnosticCommand}"
                    Content="Encrypt and upload report"
                    Margin="0,0,8,8"
                    IsEnabled="{Binding CanUploadEyeDiagnostic}" />
                <Button
                    Command="{Binding DeleteUploadedDiagnosticCommand}"
                    Content="Delete uploaded report now"
                    Margin="0,0,8,8"
                    IsEnabled="{Binding CanDeleteUploadedDiagnostic}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Classes="Header" Margin="0,10,0,-6" Text="Performance metrics" />

      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="UI Render thread" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding RenderFps, StringFormat='{}{0:F1} fps'}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="UI data thread" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding UiLoopFps, StringFormat='{}{0:F1} fps'}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Eye inference" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyeInferenceFps, StringFormat='{}{0:F1} fps'}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" Text="Mouth inference" />
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FaceInferenceFps, StringFormat='{}{0:F1} fps'}" />
        </Grid>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Text="Thread CPU Usage" />
      <TextBlock Opacity="0.7"
                 Text="{Binding ProcessCpuPercent, StringFormat='Process: {0:F0}% x 1 core'}" />
      <TextBlock Opacity="0.7" Margin="0,-4,0,0"
                 Text="{Binding ProcessorCount, StringFormat='{}{0} logical cores'}" />
      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Opacity="0.6" Text="Thread" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Opacity="0.6" Text="CPU" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Threads}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="splitViewPane:ThreadCpuRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold"
                             Text="{Binding CpuPercent, StringFormat='{}{0:F1}%'}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Margin="0,10,0,-6" Text="Eye pipeline stages (avg)" />
      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Capture + corruption check" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyeCaptureMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Transform + collect" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyeTransformMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Convert + inference" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyeInferenceMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" Text="Filter + post" />
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyePostMs, StringFormat='{}{0:F2} ms'}" />
        </Grid>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Margin="0,10,0,-6" Text="Mouth pipeline stages (avg)" />
      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Capture" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FaceCaptureMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Transform" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FaceTransformMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Convert + inference" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FaceInferenceMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" Text="Filter + post" />
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FacePostMs, StringFormat='{}{0:F2} ms'}" />
        </Grid>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Margin="0,10,0,-6" Text="Cameras" />
      <ItemsControl ItemsSource="{Binding Cameras}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="splitViewPane:CameraRow">
            <Border
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Margin="0,0,0,12"
                Padding="16">
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" Text="{Binding Name}" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Delivered (measured)" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding DeliveredFps, StringFormat='{}{0:F1} fps'}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Dropped (Last 60 seconds)" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding DroppedSummary}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Negotiated (driver)" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding NegotiatedFps, StringFormat='{}{0:F0} fps'}" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" Text="Resolution" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding Resolution}" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" Text="Pixel format" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding Format}" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
